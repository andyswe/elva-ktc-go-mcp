# Settings for elva-mcp-stdio, the read-only MCP server. install.sh copies this to
# /opt/elva/mcp.env (0640 root:elva-mcp); members of the group elva-mcp can use it.

# PostgreSQL URL of a READ-ONLY role (see deploy/readonly-role.sql), never the writer.
ELVA_DATABASE_URL=postgres://elva_ro:changeme@localhost:5432/elva
# Time zone for calendar periods (days, months) and output (default Europe/Stockholm)
#ELVA_TIMEZONE=Europe/Stockholm
# Maximum run time of one database statement (default 30s)
#ELVA_QUERY_TIMEOUT=30s
# Maximum rows returned by the query tool (default 1000)
#ELVA_QUERY_MAX_ROWS=1000
