# Copy to .env.<yourname> (git-ignored) and fill in. Run with: ./bin/elva -env-file .env.<yourname>

# Host or host:port of the KTC RCU (required)
KTC_HOST=192.168.1.100
# RCU web UI login password (required)
KTC_PASSWORD=changeme

# Meter names to read, comma separated (default: all meters on the RCU start page)
#KTC_METERS=EL-01,VV-01
# Scrape interval, aligned to wall clock (default 1m; the RCU only polls meters every 60 s)
#ELVA_INTERVAL=1m
# Timeout per request to the RCU and per database operation (default 10s)
#ELVA_TIMEOUT=10s
# Time zone of the RCU clock; its timestamps carry none (default Europe/Stockholm)
#KTC_TIMEZONE=Europe/Stockholm
# Warn when the RCU's last read of a meter is older than this; the reading is still used (default 2m)
#ELVA_MAX_METER_AGE=2m

# PostgreSQL URL. Unset: measurements are printed as JSON lines to stdout instead.
#ELVA_DATABASE_URL=postgres://elva:changeme@localhost:5432/elva
# How long to keep readings in memory while the database is unreachable (default 168h = one week)
#ELVA_DATABASE_BUFFER=168h
